# Copy to .env and fill in values for local development.
# In GitHub Actions these are set as repository secrets.

ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...

# Must be a verified sender domain in Resend dashboard
NEWSLETTER_FROM=Signal AI <news@yourdomain.com>

# Comma-separated for multiple recipients
NEWSLETTER_TO=you@example.com
